# Telegram Bot Configuration
TG_TOKEN=your_telegram_bot_token_here
TG_ADMIN_IDS=[123456789, 987654321]
TG_RECEIPT_STORAGE_CHAT_ID=123456789
TG_ADMIN_CHANNEL_ID=-1001234567890

# Database Configuration
DB_HOST=your_database_host
DB_PORT=5432
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_DATABASE=your_database_name
DB_SSL_MODE=require

# Bot Settings (Optional)
BOT_DEFAULT_PAYMENT_PRICE=700
BOT_MAX_MONTHS_PAYMENT=6
BOT_PAYMENT_REMINDER_DAYS=3
BOT_TIMEZONE=Asia/Almaty

# Kazakhstan Payment Settings
BOT_PAYMENT_LINK=https://pay.kaspi.kz/pay/

# Russia Payment Settings
BOT_RU_PAYMENT_PRICE=5000
BOT_RU_PAYMENT_CARD=1111
BOT_RU_PAYMENT_BANK=bank
BOT_RU_PAYMENT_RECIPIENT=john doe

# Support
BOT_SUPPORT_USERNAME=sptfy_premium
